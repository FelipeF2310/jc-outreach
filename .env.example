# Local practice: npm run demo enables the loopback-only fixture backend.
# Hosted authentication is a SEPARATE synthetic-preview mode, not real-data approval.
# Copy to an ignored environment file and configure locally; never paste secrets in chat.
# Do not set JCO_SYNTHETIC_ONLY when using the hosted synthetic-preview mode.
JCO_HOSTED_STAGE=
JCO_APP_ORIGIN=
JCO_SUPABASE_URL=
JCO_SUPABASE_PUBLISHABLE_KEY=
JCO_ADMIN_EMAILS=
# Runtime connection: dedicated jco_admin_reader role, not the database owner.
DATABASE_URL=
# Optional provider certificate authority PEM; TLS verification stays enabled.
JCO_DATABASE_CA=
# Owner connection ONLY for the explicit empty-database bootstrap command.
# Keep out of the deployed application's environment.
JCO_MIGRATION_DATABASE_URL=
